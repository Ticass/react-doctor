{
  "name": "react-doctor-rewritten",
  "version": "0.2.5",
  "description": "Diagnose and fix React codebases for security, performance, correctness, accessibility, bundle-size, and architecture issues (fork of millionco/react-doctor with --hide-branding HTML report for CI).",
  "keywords": [
    "accessibility",
    "diagnostics",
    "knip",
    "linter",
    "nextjs",
    "oxlint",
    "performance",
    "react",
    "react-compiler",
    "react-native",
    "security",
    "tanstack",
    "typescript"
  ],
  "homepage": "https://github.com/Ticass/react-doctor-rewritten#readme",
  "bugs": {
    "url": "https://github.com/Ticass/react-doctor-rewritten/issues"
  },
  "license": "MIT",
  "author": "Alexis Grenier",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ticass/react-doctor-rewritten.git",
    "directory": "packages/react-doctor-rewritten"
  },
  "bin": {
    "react-doctor-rewritten": "bin/react-doctor.js"
  },
  "files": [
    "bin/**",
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/skills/**"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./api": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./oxlint-plugin": {
      "types": "./dist/react-doctor-plugin.d.ts",
      "default": "./dist/react-doctor-plugin.js"
    },
    "./eslint-plugin": {
      "types": "./dist/eslint-plugin.d.ts",
      "default": "./dist/eslint-plugin.js"
    }
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "node -e \"try{require('node:fs').rmSync('dist',{recursive:true,force:true})}catch(e){}\" && tsdown",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && vitest run"
  },
  "dependencies": {
    "agent-install": "0.0.5",
    "commander": "^14.0.3",
    "knip": "^6.10.0",
    "ora": "^9.4.0",
    "oxlint": "^1.63.0",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2",
    "typescript": ">=5.0.4 <7"
  },
  "devDependencies": {
    "@types/prompts": "^2.4.9",
    "@typescript-eslint/types": "^8.59.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-you-might-not-need-an-effect": "^0.10.1",
    "tsdown": "^0.20.3"
  },
  "peerDependencies": {
    "eslint-plugin-react-hooks": "^6 || ^7",
    "eslint-plugin-react-you-might-not-need-an-effect": "^0.10"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-react-hooks": {
      "optional": true
    },
    "eslint-plugin-react-you-might-not-need-an-effect": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
